# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# OS / IDE
.DS_Store
.vscode/
.idea/

# Secrets
.env
.env.*
!.env.example

# 대용량 생성 데이터 (샘플·날씨표·공휴일만 커밋, 원본 전체는 제외)
data/processed/train.csv*
data/processed/valid.csv*
data/processed/test.csv*
data/raw/subway/*.csv
!data/raw/subway/*_sample.csv

# 학습 산출물 (모델 바이너리·이력 캐시는 커밋하지 않는다)
models/*.joblib
models/*.npz
models/*.pt
# 모델 패턴은 하위 폴더까지 막지 않는다 (실험 산출물이 앱 모델과 섞이지 않게 폴더째 제외)
# 단, grid_results.json(후보별 점수 증거)은 커밋할 수 있게 둔다
models/_probe/*
!models/_probe/grid_results.json

# 실행 로그
*.log
