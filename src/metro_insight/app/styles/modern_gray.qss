/*
 * Modern Gray — Metro Insight 기본 스타일
 *
 * 색상
 *   배경        #f4f5f7    카드        #ffffff
 *   테두리      #e3e5e8    카드 테두리 #eceef1
 *   본문        #1f2328    보조 텍스트 #6b7078
 *   강조        #374151
 */

/* ---------- 기본 ---------- */
QMainWindow,
QWidget#centralWidget {
    background: #f4f5f7;
}

QWidget {
    color: #1f2328;
}

QToolTip {
    background: #374151;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
}

/* ---------- 헤더 ---------- */
QWidget#header {
    background: #ffffff;
    border-bottom: 1px solid #e3e5e8;
}

QLabel#appTitle {
    color: #111827;
    font-size: 17px;
    font-weight: 700;
}

QLabel#appSubtitle {
    color: #6b7078;
    padding-top: 2px;
}

QLabel#headerMeta {
    color: #4b5563;
    background: #f1f2f4;
    border-radius: 11px;
    padding: 3px 11px;
    font-size: 12px;
}

/* ---------- 노선도 ---------- */
QGraphicsView#stationMap {
    background: #fbfbfc;
    border: 1px solid #e3e5e8;
    border-radius: 12px;
}

/* 지도 위에 겹친 카드 (범례, 선택한 역) */
QFrame#mapCard {
    background: #ffffff;
    border: 1px solid #eceef1;
    border-radius: 12px;
}

QFrame#mapCard QLabel {
    background: transparent;
}

QLabel#cardCaption {
    color: #9aa0a8;
    font-size: 11px;
    font-weight: 600;
}

QLabel#legendText {
    color: #4b5563;
    font-size: 12px;
}

QLabel#stationName {
    color: #111827;
    font-size: 20px;
    font-weight: 700;
}

QLabel#cardHint {
    color: #6b7078;
    font-size: 12px;
}

/* 호선 번호 배지 (배경색은 호선별로 코드에서 지정) */
QLabel#lineBadge {
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
}

/* 확대·축소 버튼 */
QFrame#zoomControls {
    background: #ffffff;
    border: 1px solid #eceef1;
    border-radius: 10px;
}

QFrame#zoomControls QToolButton {
    background: transparent;
    border: none;
    border-radius: 7px;
    min-width: 30px;
    min-height: 30px;
}

QFrame#zoomControls QToolButton:hover {
    background: #f1f2f4;
}

QFrame#zoomControls QToolButton:pressed {
    background: #e5e7eb;
}

/* 지도 데이터 출처 */
QLabel#mapAttribution {
    color: #9aa0a8;
    background: rgba(255, 255, 255, 210);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 10px;
}

/* 헤더의 역 정보 패널 열기·닫기 버튼 */
QPushButton#panelToggle {
    color: #374151;
    background: #f1f2f4;
    border: none;
    border-radius: 8px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#panelToggle:hover {
    background: #e5e7eb;
}

QPushButton#panelToggle:checked {
    color: #ffffff;
    background: #374151;
}

/* ---------- 역 정보 패널 ---------- */
QFrame#stationPanel {
    background: #ffffff;
    border: 1px solid #e3e5e8;
    border-radius: 12px;
}

QFrame#stationPanel QLabel {
    background: transparent;
}

QWidget#panelForm,
QScrollArea#panelScroll,
QScrollArea#panelScroll > QWidget {
    background: transparent;
}

QLabel#panelTitle {
    color: #111827;
    font-size: 15px;
    font-weight: 700;
}

QLabel#fieldLabel {
    color: #6b7078;
    font-size: 12px;
    font-weight: 400;
}

/* 날짜 아래에 붙는 읽기 전용 요일 */
QLabel#weekdayText {
    color: #4b5563;
    font-size: 12px;
}

QLabel#fieldNote {
    color: #9aa0a8;
    font-size: 11px;
}

QLabel#fieldNote[error="true"] {
    color: #b42318;
}

/* 미검증 장기 추정 안내 (결과 카드) */
QLabel#resultWarning {
    color: #b42318;
    font-size: 11px;
    font-weight: 600;
}

QToolButton#panelClose {
    background: transparent;
    border: none;
    border-radius: 7px;
    min-width: 28px;
    min-height: 28px;
}

QToolButton#panelClose:hover {
    background: #f1f2f4;
}

QPushButton#textButton {
    color: #374151;
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#textButton:hover {
    background: #f1f2f4;
}

/* 입력 칸 */
QFrame#stationPanel QLineEdit,
QFrame#stationPanel QComboBox,
QFrame#stationPanel QAbstractSpinBox {
    color: #1f2328;
    background: #f7f8fa;
    border: 1px solid #e3e5e8;
    border-radius: 8px;
    padding: 6px 9px;
    selection-background-color: #374151;
    selection-color: #ffffff;
}

QFrame#stationPanel QLineEdit:hover,
QFrame#stationPanel QComboBox:hover,
QFrame#stationPanel QAbstractSpinBox:hover {
    border-color: #cfd3d9;
}

QFrame#stationPanel QLineEdit:focus,
QFrame#stationPanel QComboBox:focus,
QFrame#stationPanel QAbstractSpinBox:focus {
    background: #ffffff;
    border-color: #374151;
}

/* 미래 시각의 기온 칸: 관측값이 없어 평년값을 가정으로 보여 준다 */
QFrame#stationPanel QAbstractSpinBox[climatology="true"] {
    color: #9aa0a8;
}

QFrame#stationPanel QComboBox:disabled {
    color: #1f2328;
    background: #ffffff;
}

QFrame#stationPanel QComboBox {
    combobox-popup: 0;  /* 목록을 칸 바로 아래에 연다 */
}

QFrame#stationPanel QComboBox::drop-down,
QFrame#stationPanel QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
}

QFrame#stationPanel QComboBox::down-arrow,
QFrame#stationPanel QDateEdit::down-arrow {
    image: url(styles:chevron-down.svg);
    width: 14px;
    height: 14px;
}

QFrame#stationPanel QComboBox::down-arrow:disabled {
    image: none;
}

QFrame#stationPanel QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #e3e5e8;
    border-radius: 8px;
    padding: 4px;
    outline: 0;
    selection-background-color: #f1f2f4;
    selection-color: #111827;
}

QFrame#stationPanel QCheckBox {
    color: #374151;
    font-size: 12px;
    spacing: 6px;
}

QFrame#stationPanel QCheckBox:disabled {
    color: #9aa0a8;
}

QFrame#stationPanel QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background: #ffffff;
    border: 1px solid #c9cdd3;
    border-radius: 4px;
}

QFrame#stationPanel QCheckBox::indicator:hover {
    border-color: #374151;
}

QFrame#stationPanel QCheckBox::indicator:checked {
    background: #374151;
    border-color: #374151;
    image: url(styles:check.svg);
}

QFrame#stationPanel QCheckBox::indicator:checked:disabled {
    background: #9aa0a8;
    border-color: #9aa0a8;
}

/* 예측하기 버튼과 결과 카드 */
QPushButton#primaryButton {
    color: #ffffff;
    background: #374151;
    border: none;
    border-radius: 8px;
    padding: 9px 14px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background: #1f2937;
}

QPushButton#primaryButton:pressed {
    background: #111827;
}

QFrame#resultCard {
    background: #f7f8fa;
    border: 1px solid #e3e5e8;
    border-radius: 10px;
}

QFrame#resultDivider {
    background: #e3e5e8;
    border: none;
}

/* 머신러닝(A~C)과 딥러닝(D·E) 사이의 구분선 */
QFrame#resultGroupDivider {
    background: #cfd4da;
    border: none;
}

/* 결과 카드의 접었다 펴는 제목 줄 */
QPushButton#accordionHeader {
    color: #9aa0a8;
    background: transparent;
    border: none;
    padding: 3px 0;
    font-size: 11px;
    font-weight: 600;
    text-align: left;
}

QPushButton#accordionHeader:hover,
QPushButton#accordionHeader:checked {
    color: #374151;
}

/* 결과 카드의 고정 제목 줄 (접히지 않는 구역) */
QLabel#resultSectionTitle {
    color: #374151;
    padding: 3px 0;
    font-size: 11px;
    font-weight: 700;
}

QLabel#resultValue {
    color: #1f2328;
    font-size: 12px;
}

QLabel#resultNumber {
    color: #1f2328;
    font-size: 13px;
}

/* 계산할 수 없는 값 (D·E 실측 없음) */
QLabel#resultNumber[missing="true"] {
    color: #b42318;
}


/* 검색 결과 목록 */
QListWidget#searchResults {
    background: #ffffff;
    border: 1px solid #e3e5e8;
    border-radius: 10px;
    padding: 4px;
    outline: 0;
}

QListWidget#searchResults::item {
    color: #6b7078;
    border-radius: 6px;
    padding-left: 8px;
}

QListWidget#searchResults::item:hover,
QListWidget#searchResults::item:selected {
    background: #f1f2f4;
}

QLabel#resultName {
    color: #1f2328;
    font-size: 13px;
}

/* 패널 스크롤바 */
QScrollArea#panelScroll QScrollBar:vertical {
    background: transparent;
    width: 6px;
    margin: 0;
}

QScrollArea#panelScroll QScrollBar::handle:vertical {
    background: #d6d9de;
    border-radius: 3px;
    min-height: 32px;
}

QScrollArea#panelScroll QScrollBar::add-line:vertical,
QScrollArea#panelScroll QScrollBar::sub-line:vertical,
QScrollArea#panelScroll QScrollBar::add-page:vertical,
QScrollArea#panelScroll QScrollBar::sub-page:vertical {
    height: 0;
    background: none;
}

/* ---------- 날짜 선택 달력 팝업 ---------- */
/* Windows 다크 모드에서 상단 연·월 바(Highlight 색으로 그림)와 월 목록 메뉴(시스템
   팔레트를 따라감)가 검게 보이므로 QSS 로 직접 밝게 고정한다. */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background: #f1f2f4;
    border-bottom: 1px solid #e3e5e8;
}

QCalendarWidget QToolButton {
    background: transparent;
    color: #1f2328;
    border: none;
    border-radius: 6px;
    padding: 3px 8px;
    font-weight: 600;
}

QCalendarWidget QToolButton:hover {
    background: #e5e7eb;
}

QCalendarWidget QToolButton::menu-indicator {
    image: url(styles:chevron-down.svg);
    width: 12px;
    height: 12px;
    subcontrol-position: right center;
}

QCalendarWidget QSpinBox#qt_calendar_yearedit {
    background: #ffffff;
    color: #1f2328;
    border: 1px solid #374151;
    border-radius: 4px;
    selection-background-color: #374151;
    selection-color: #ffffff;
}

/* 월 목록 드롭다운 (QMenu). 달력 안에서만 쓰는 메뉴라 달력 아래로 한정한다 */
QCalendarWidget QMenu,
QCalendarWidget QMenu QWidget {
    background: #ffffff;
    color: #1f2328;
    border: none;
}

QCalendarWidget QMenu {
    border: 1px solid #e3e5e8;
    border-radius: 8px;
    padding: 4px;
}

QCalendarWidget QMenu::item {
    background: transparent;
    color: #1f2328;
    padding: 4px 24px 4px 12px;
    border-radius: 6px;
}

QCalendarWidget QMenu::item:selected {
    background: #f1f2f4;
    color: #111827;
}
